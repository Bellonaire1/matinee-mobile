# =============================================================================
# Matinee Backend Environment Configuration (.env.example)
# Copy this file to .env and provide your deployment-specific credentials.
# NOTE: Never commit .env with real credentials to source control.
# =============================================================================

# Server Network Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# PostgreSQL Primary Database Connection (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# In production, use your Neon pooled connection string with sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/matinee_db?schema=public"

# Redis Cache & Hold Lease Engine (Future Milestone M05.2+)
# Format: redis://[:PASSWORD@]HOST[:PORT][/DATABASE]
REDIS_URL="redis://localhost:6379"

# JWT & Authentication Secrets (Future Auth Module)
JWT_SECRET="replace-with-a-secure-random-64-character-hex-secret-in-production"
JWT_EXPIRES_IN="7d"

# The Movie Database (TMDB) API Proxy (Next Milestone M05.2)
# Required for server-side film metadata discovery & image caching
TMDB_API_KEY="replace-with-tmdb-v3-api-key"
TMDB_ACCESS_TOKEN="replace-with-tmdb-v4-read-access-token"
TMDB_BASE_URL="https://api.themoviedb.org/3"
TMDB_IMAGE_BASE_URL="https://image.tmdb.org/t/p"

# Payment Gateway Credentials (Future Milestone M05.3+)
# Test-mode simulation credentials for test transactions
PAYMENT_PROVIDER="TEST_GATEWAY"
PAYMENT_TEST_SECRET_KEY="test_sk_mock_placeholder"
PAYMENT_WEBHOOK_SECRET="test_whsec_mock_placeholder"

